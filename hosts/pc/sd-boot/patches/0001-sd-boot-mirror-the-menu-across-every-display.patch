diff --git a/src/boot/gop.c b/src/boot/gop.c
new file mode 100644
index 0000000000..bc460946f6
--- /dev/null
+++ b/src/boot/gop.c
@@ -0,0 +1,279 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "edid.h"
+#include "efi-log.h"
+#include "gop.h"
+#include "proto/device-path.h"
+#include "proto/edid-active.h"
+#include "proto/edid-discovered.h"
+#include "proto/pci-io.h"
+#include "util.h"
+
+#define PCI_CLASS_DISPLAY 0x03
+
+/* EDID for one specific display, rather than console.c's global LocateProtocol lookup. */
+static bool try_edid(GopDisplay *d, EFI_GUID *guid, const char *name) {
+        /* Active and discovered EDID share this layout, so one struct covers both. */
+        EFI_EDID_ACTIVE_PROTOCOL *edid = NULL;
+
+        if (BS->HandleProtocol(d->handle, guid, (void **) &edid) != EFI_SUCCESS)
+                return false;
+        if (!edid || !edid->Edid || edid->SizeOfEdid == 0)
+                return false;
+
+        uint32_t w, h;
+        if (edid_get_preferred_mode(edid->Edid, edid->SizeOfEdid, &w, &h) < 0)
+                return false;
+
+        d->native_width = w;
+        d->native_height = h;
+        log_debug("Display %p: %s EDID reports native %ux%u.", d->handle, name, w, h);
+        return true;
+}
+
+/* Prefers the active EDID (post platform override), falling back to what the monitor reported. */
+static void read_native_resolution(GopDisplay *d) {
+        assert(d);
+
+        if (try_edid(d, MAKE_GUID_PTR(EFI_EDID_ACTIVE_PROTOCOL), "active"))
+                return;
+        if (try_edid(d, MAKE_GUID_PTR(EFI_EDID_DISCOVERED_PROTOCOL), "discovered"))
+                return;
+
+        log_debug("Display %p: no usable EDID, will fall back to the largest mode.", d->handle);
+}
+
+
+/* Native mode if EDID tells us one, otherwise whatever the firmware already chose. Deliberately
+ * per-display: this is what the stock ConOut path cannot do, because ConSplitter forces one mode on
+ * every console. We do not reach for the largest mode -- firmware maximums are often far above what
+ * the panel actually is (OVMF offers 2048x2048), and POST's own choice is known to work. */
+static EFI_STATUS select_best_mode(GopDisplay *d) {
+        assert(d);
+        assert(d->gop);
+
+        if (!d->gop->Mode || d->gop->Mode->MaxMode == 0)
+                return EFI_UNSUPPORTED;
+
+        uint32_t initial_mode = d->gop->Mode->Mode;
+        uint32_t initial_w = 0, initial_h = 0;
+        if (d->gop->Mode->Info) {
+                initial_w = d->gop->Mode->Info->HorizontalResolution;
+                initial_h = d->gop->Mode->Info->VerticalResolution;
+        }
+
+        uint32_t fallback_mode = initial_mode, fallback_w = initial_w, fallback_h = initial_h;
+        uint64_t largest_area = 0;
+        bool found_native = false;
+
+        for (uint32_t m = 0; m < d->gop->Mode->MaxMode; m++) {
+                EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *info = NULL;
+                size_t info_size = 0;
+
+                if (d->gop->QueryMode(d->gop, m, &info_size, &info) != EFI_SUCCESS)
+                        continue;
+                if (!info || info_size < sizeof(*info)) {
+                        free(info);
+                        continue;
+                }
+
+                uint32_t w = info->HorizontalResolution, h = info->VerticalResolution;
+                free(info);
+
+                if (w == 0 || h == 0)
+                        continue;
+
+                if (d->native_width != 0 && w == d->native_width && h == d->native_height) {
+                        d->mode = m;
+                        d->width = w;
+                        d->height = h;
+                        found_native = true;
+                        break;
+                }
+
+                /* Only used if the firmware left us without a valid current mode. */
+                uint64_t area = (uint64_t) w * (uint64_t) h;
+                if (initial_w == 0 && area > largest_area) {
+                        largest_area = area;
+                        fallback_mode = m;
+                        fallback_w = w;
+                        fallback_h = h;
+                }
+        }
+
+        if (!found_native) {
+                if (fallback_w == 0 || fallback_h == 0)
+                        return EFI_NOT_FOUND;
+
+                d->mode = fallback_mode;
+                d->width = fallback_w;
+                d->height = fallback_h;
+        }
+
+        if (d->gop->Mode->Mode != d->mode) {
+                EFI_STATUS err = d->gop->SetMode(d->gop, d->mode);
+                if (err != EFI_SUCCESS)
+                        return log_debug_status(
+                                        err,
+                                        "Display %p: cannot set mode %u (%ux%u): %m",
+                                        d->handle, d->mode, d->width, d->height);
+        }
+
+        log_debug("Display %p: using mode %u (%ux%u)%s.",
+                  d->handle, d->mode, d->width, d->height,
+                  found_native ? ", EDID native" : ", firmware default");
+        return EFI_SUCCESS;
+}
+
+static bool display_init(GopDisplay *d, EFI_HANDLE handle) {
+        assert(d);
+
+        EFI_GRAPHICS_OUTPUT_PROTOCOL *gop = NULL;
+        if (BS->HandleProtocol(handle, MAKE_GUID_PTR(EFI_GRAPHICS_OUTPUT_PROTOCOL), (void **) &gop) != EFI_SUCCESS)
+                return false;
+        if (!gop || !gop->Mode)
+                return false;
+
+        *d = (GopDisplay) {
+                .handle = handle,
+                .gop = gop,
+        };
+
+        read_native_resolution(d);
+        return select_best_mode(d) == EFI_SUCCESS;
+}
+
+/* ConSplitter publishes an aggregate GOP on the console handle that fans out to the real ones.
+ * Rendering to it as well as to each device would paint everything twice and report a resolution
+ * belonging to no single display, so skip it -- unless it is all we have. */
+static bool handle_is_console_aggregate(EFI_HANDLE handle) {
+        if (handle == ST->ConsoleOutHandle)
+                return true;
+
+        /* The aggregate handle is virtual and so carries no device path, the same tell console.c
+         * already relies on for ConOut. */
+        EFI_DEVICE_PATH *dp = NULL;
+        return BS->HandleProtocol(handle, MAKE_GUID_PTR(EFI_DEVICE_PATH_PROTOCOL), (void **) &dp) != EFI_SUCCESS;
+}
+
+static size_t collect(GopDisplay **displays, size_t n_existing, bool skip_aggregate) {
+        _cleanup_free_ EFI_HANDLE *handles = NULL;
+        size_t n_handles = 0;
+
+        EFI_STATUS err = BS->LocateHandleBuffer(
+                        ByProtocol,
+                        MAKE_GUID_PTR(EFI_GRAPHICS_OUTPUT_PROTOCOL),
+                        NULL,
+                        &n_handles,
+                        &handles);
+        if (err != EFI_SUCCESS || n_handles == 0)
+                return 0;
+
+        size_t added = 0;
+
+        for (size_t i = 0; i < n_handles; i++) {
+                if (skip_aggregate && handle_is_console_aggregate(handles[i]))
+                        continue;
+
+                bool known = false;
+                for (size_t j = 0; j < n_existing + added; j++)
+                        if ((*displays)[j].handle == handles[i]) {
+                                known = true;
+                                break;
+                        }
+                if (known)
+                        continue;
+
+                GopDisplay candidate;
+                if (!display_init(&candidate, handles[i]))
+                        continue;
+
+                *displays = xrealloc(
+                                *displays,
+                                (n_existing + added) * sizeof(GopDisplay),
+                                (n_existing + added + 1) * sizeof(GopDisplay));
+                (*displays)[n_existing + added] = candidate;
+                added++;
+        }
+
+        return added;
+}
+
+size_t gop_enumerate(GopDisplay **ret_displays) {
+        assert(ret_displays);
+
+        *ret_displays = NULL;
+        size_t n = collect(ret_displays, 0, /* skip_aggregate= */ true);
+
+        /* No per-device GOP: a firmware that only offers the aggregate, or a VM. Use it anyway. */
+        if (n == 0)
+                n = collect(ret_displays, 0, /* skip_aggregate= */ false);
+
+        log_debug("Found %zu usable display(s).", n);
+        return n;
+}
+
+size_t gop_rescan(GopDisplay **displays, size_t n_displays) {
+        assert(displays);
+
+        return collect(displays, n_displays, /* skip_aggregate= */ true);
+}
+
+bool gop_reassert_mode(GopDisplay *d) {
+        assert(d);
+        assert(d->gop);
+
+        if (!d->gop->Mode)
+                return false;
+
+        /* A display that went away and came back can land in a different mode, or in none at all.
+         * Setting it again also retrains the link, which is what wakes a monitor out of standby. */
+        if (d->gop->Mode->Mode == d->mode)
+                return false;
+
+        if (d->gop->SetMode(d->gop, d->mode) != EFI_SUCCESS)
+                return false;
+
+        log_debug("Display %p: re-asserted mode %u.", d->handle, d->mode);
+        return true;
+}
+
+/* Last resort for a display that was off at POST and so never got a GOP handle: make the firmware
+ * re-run its graphics driver's Start(), which re-probes the connectors. This can also take the
+ * console down until reboot, hence the loader.conf opt-in. */
+EFI_STATUS gop_force_reconnect(void) {
+        _cleanup_free_ EFI_HANDLE *handles = NULL;
+        size_t n_handles = 0;
+
+        EFI_STATUS err = BS->LocateHandleBuffer(
+                        ByProtocol, MAKE_GUID_PTR(EFI_PCI_IO_PROTOCOL), NULL, &n_handles, &handles);
+        if (err != EFI_SUCCESS)
+                return err;
+
+        size_t n_reconnected = 0;
+
+        for (size_t i = 0; i < n_handles; i++) {
+                EFI_PCI_IO_PROTOCOL *pci_io = NULL;
+                if (BS->HandleProtocol(handles[i], MAKE_GUID_PTR(EFI_PCI_IO_PROTOCOL), (void **) &pci_io) != EFI_SUCCESS)
+                        continue;
+
+                /* Base class lives at offset 0x0b in PCI config space. */
+                uint8_t base_class = 0;
+                if (pci_io->Pci.Read(pci_io, EfiPciIoWidthUint8, 0x0b, 1, &base_class) != EFI_SUCCESS)
+                        continue;
+                if (base_class != PCI_CLASS_DISPLAY)
+                        continue;
+
+                (void) BS->DisconnectController(handles[i], NULL, NULL);
+                err = BS->ConnectController(handles[i], NULL, NULL, /* Recursive= */ true);
+                if (err != EFI_SUCCESS) {
+                        log_debug_status(err, "Failed to reconnect display controller %p: %m", handles[i]);
+                        continue;
+                }
+
+                n_reconnected++;
+        }
+
+        log_debug("Reconnected %zu display controller(s).", n_reconnected);
+        return n_reconnected > 0 ? EFI_SUCCESS : EFI_NOT_FOUND;
+}
