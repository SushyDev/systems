+
+/* Same shape as EFI_EDID_DISCOVERED_PROTOCOL, but reflects the EDID actually in use after any
+ * platform override. Unlike the discovered one we look this up per GOP handle, not globally. */
+#define EFI_EDID_ACTIVE_PROTOCOL_GUID \
+        GUID_DEF(0xbd8c1056, 0x9f36, 0x44ec, 0x92, 0xa8, 0xa6, 0x33, 0x7f, 0x81, 0x79, 0x86)
+
+typedef struct {
+        uint32_t SizeOfEdid;
+        uint8_t *Edid;
+} EFI_EDID_ACTIVE_PROTOCOL;
diff --git a/src/boot/textfb.c b/src/boot/textfb.c
new file mode 100644
index 0000000000..3438ee94be
--- /dev/null
+++ b/src/boot/textfb.c
@@ -0,0 +1,608 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "efi-log.h"
+#include "font-spleen.h"
+#include "gop.h"
+#include "proto/simple-text-io.h"
+#include "textfb.h"
+#include "util.h"
+
+/* Aim for roughly this much text; the font is upscaled by whatever integer factor gets closest, so
+ * a 1080p TV and a 1440p monitor end up with similar apparent text size. */
+#define TARGET_COLS 100
+#define TARGET_ROWS 28
+
+#define FONT_SCALE_MAX 8
+
+/* Below this a grid is not worth driving, so leave the firmware console alone. */
+#define MIN_COLS 40
+#define MIN_ROWS 10
+
+typedef struct {
+        char16_t c;
+        uint8_t attr;
+} Cell;
+
+/* Mode 0 picks a scale per display; modes 1..FONT_SCALE_MAX force that scale everywhere, which is
+ * what the menu's existing console-mode key now cycles through. */
+#define N_MODES (FONT_SCALE_MAX + 1)
+
+typedef struct {
+        int32_t MaxMode;
+        int32_t Mode;
+        int32_t Attribute;
+        int32_t CursorColumn;
+        int32_t CursorRow;
+        bool CursorVisible;
+} TextFbMode;
+
+static GopDisplay *displays = NULL;
+static size_t n_displays = 0;
+
+static Cell *grid = NULL;
+static size_t n_cols = 0, n_rows = 0;
+
+static EFI_GRAPHICS_OUTPUT_BLT_PIXEL *cell_buf = NULL;
+static size_t cell_buf_n_px = 0;
+
+static EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *saved_conout = NULL;
+static bool initialized = false;
+static uint64_t generation = 0;
+static EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL textfb_proto;
+static TextFbMode textfb_mode;
+
+/* Standard CGA/EFI 16-colour palette. EFI_GRAPHICS_OUTPUT_BLT_PIXEL is BGRA. */
+static const EFI_GRAPHICS_OUTPUT_BLT_PIXEL palette[16] = {
+        { 0x00, 0x00, 0x00, 0x00 }, /* black */
+        { 0xaa, 0x00, 0x00, 0x00 }, /* blue */
+        { 0x00, 0xaa, 0x00, 0x00 }, /* green */
+        { 0xaa, 0xaa, 0x00, 0x00 }, /* cyan */
+        { 0x00, 0x00, 0xaa, 0x00 }, /* red */
+        { 0xaa, 0x00, 0xaa, 0x00 }, /* magenta */
+        { 0x00, 0x55, 0xaa, 0x00 }, /* brown */
+        { 0xaa, 0xaa, 0xaa, 0x00 }, /* light gray */
+        { 0x55, 0x55, 0x55, 0x00 }, /* dark gray */
+        { 0xff, 0x55, 0x55, 0x00 }, /* light blue */
+        { 0x55, 0xff, 0x55, 0x00 }, /* light green */
+        { 0xff, 0xff, 0x55, 0x00 }, /* light cyan */
+        { 0x55, 0x55, 0xff, 0x00 }, /* light red */
+        { 0xff, 0x55, 0xff, 0x00 }, /* light magenta */
+        { 0x55, 0xff, 0xff, 0x00 }, /* yellow */
+        { 0xff, 0xff, 0xff, 0x00 }, /* white */
+};
+
+static const uint8_t *glyph_for(char16_t c) {
+        if (c >= FONT_FIRST_CHAR && c <= FONT_LAST_CHAR)
+                return font8x16[c - FONT_FIRST_CHAR];
+
+        return font8x16_replacement;
+}
+
+static uint32_t auto_scale(const GopDisplay *d) {
+        assert(d);
+
+        uint32_t by_width = d->width / (FONT_WIDTH * TARGET_COLS);
+        uint32_t by_height = d->height / (FONT_HEIGHT * TARGET_ROWS);
+        uint32_t s = MIN(by_width, by_height);
+
+        return CLAMP(s, 1U, (uint32_t) FONT_SCALE_MAX);
+}
+
+static void ensure_cell_buf(void) {
+        size_t needed = 0;
+
+        FOREACH_ARRAY(d, displays, n_displays)
+                needed = MAX(needed,
+                             (size_t) (FONT_WIDTH * d->font_scale) * (size_t) (FONT_HEIGHT * d->font_scale));
+
+        if (needed <= cell_buf_n_px)
+                return;
+
+        cell_buf = xrealloc(cell_buf,
+                            cell_buf_n_px * sizeof(EFI_GRAPHICS_OUTPUT_BLT_PIXEL),
+                            needed * sizeof(EFI_GRAPHICS_OUTPUT_BLT_PIXEL));
+        cell_buf_n_px = needed;
+}
+
+/* The scale a display would use for a mode. A forced scale can be too big for a small display, so
+ * back off until the grid it yields is usable. */
+static uint32_t scale_for(const GopDisplay *d, int32_t mode) {
+        assert(d);
+
+        uint32_t scale = mode == 0 ? auto_scale(d) : (uint32_t) mode;
+
+        while (scale > 1 &&
+               (d->width / (FONT_WIDTH * scale) < MIN_COLS ||
+                d->height / (FONT_HEIGHT * scale) < MIN_ROWS))
+                scale--;
+
+        return scale;
+}
+
+/* Derives the shared grid for a mode, which has to be the smallest any single display can show.
+ * With apply set, also commits each display's font scale and centring offsets, and resizes the
+ * glyph buffer to match. Decides before committing, so a mode that turns out to be unusable cannot
+ * leave the displays claiming a scale the glyph buffer is not sized for. */
+static bool layout(int32_t mode, bool apply, size_t *ret_cols, size_t *ret_rows) {
+        assert(ret_cols);
+        assert(ret_rows);
+
+        if (n_displays == 0)
+                return false;
+
+        size_t cols = SIZE_MAX, rows = SIZE_MAX;
+
+        FOREACH_ARRAY(d, displays, n_displays) {
+                uint32_t scale = scale_for(d, mode);
+
+                cols = MIN(cols, (size_t) (d->width / (FONT_WIDTH * scale)));
+                rows = MIN(rows, (size_t) (d->height / (FONT_HEIGHT * scale)));
+        }
+
+        if (cols < MIN_COLS || rows < MIN_ROWS)
+                return false;
+
+        if (apply) {
+                FOREACH_ARRAY(d, displays, n_displays) {
+                        d->font_scale = scale_for(d, mode);
+                        d->x_off = (d->width - cols * FONT_WIDTH * d->font_scale) / 2;
+                        d->y_off = (d->height - rows * FONT_HEIGHT * d->font_scale) / 2;
+                }
+
+                ensure_cell_buf();
+        }
+
+        *ret_cols = cols;
+        *ret_rows = rows;
+        return true;
+}
+
+
+static void draw_cell(GopDisplay *d, size_t x, size_t y, Cell cell) {
+        assert(d);
+
+        if (x >= n_cols || y >= n_rows)
+                return;
+
+        uint32_t s = d->font_scale;
+        uint32_t cw = FONT_WIDTH * s, ch = FONT_HEIGHT * s;
+        EFI_GRAPHICS_OUTPUT_BLT_PIXEL fg = palette[cell.attr & 0x0f];
+        EFI_GRAPHICS_OUTPUT_BLT_PIXEL bg = palette[(cell.attr >> 4) & 0x0f];
+        const uint8_t *glyph = glyph_for(cell.c);
+
+        /* A blank cell is a plain fill, no buffer needed. */
+        if (cell.c == ' ') {
+                (void) d->gop->Blt(d->gop, &bg, EfiBltVideoFill, 0, 0,
+                                   d->x_off + x * cw, d->y_off + y * ch, cw, ch, 0);
+                return;
+        }
+
+        for (uint32_t gy = 0; gy < FONT_HEIGHT; gy++) {
+                uint8_t bits = glyph[gy];
+
+                for (uint32_t gx = 0; gx < FONT_WIDTH; gx++) {
+                        EFI_GRAPHICS_OUTPUT_BLT_PIXEL px = (bits & (0x80U >> gx)) ? fg : bg;
+
+                        /* Replicate each font pixel into an s x s block. */
+                        for (uint32_t sy = 0; sy < s; sy++) {
+                                EFI_GRAPHICS_OUTPUT_BLT_PIXEL *row =
+                                                cell_buf + (size_t) (gy * s + sy) * cw + gx * s;
+                                for (uint32_t sx = 0; sx < s; sx++)
+                                        row[sx] = px;
+                        }
+                }
+        }
+
+        (void) d->gop->Blt(d->gop, cell_buf, EfiBltBufferToVideo, 0, 0,
+                           d->x_off + x * cw, d->y_off + y * ch, cw, ch, 0);
+}
+
+static void fill_display(GopDisplay *d, uint8_t attr) {
+        assert(d);
+
+        EFI_GRAPHICS_OUTPUT_BLT_PIXEL bg = palette[(attr >> 4) & 0x0f];
+
+        /* Covers the centring margins too, so no stale pixels survive a mode change. */
+        (void) d->gop->Blt(d->gop, &bg, EfiBltVideoFill, 0, 0, 0, 0, d->width, d->height, 0);
+}
+
+static void paint_display(GopDisplay *d, uint8_t fill_attr) {
+        assert(d);
+
+        uint8_t fill_bg = (fill_attr >> 4) & 0x0f;
+
+        for (size_t y = 0; y < n_rows; y++)
+                for (size_t x = 0; x < n_cols; x++) {
+                        Cell cell = grid[y * n_cols + x];
+
+                        /* Blanks only come for free where the screen fill already laid down their
+                         * background -- a highlighted run's spaces still have to be drawn. */
+                        if (cell.c == ' ' && ((cell.attr >> 4) & 0x0f) == fill_bg)
+                                continue;
+
+                        draw_cell(d, x, y, cell);
+                }
+}
+
+static void repaint_all(void) {
+        FOREACH_ARRAY(d, displays, n_displays) {
+                fill_display(d, textfb_mode.Attribute);
+                paint_display(d, textfb_mode.Attribute);
+        }
+}
+
+static void write_cell(size_t x, size_t y, char16_t c, uint8_t attr) {
+        if (x >= n_cols || y >= n_rows)
+                return;
+
+        Cell cell = { .c = c, .attr = attr };
+        grid[y * n_cols + x] = cell;
+
+        FOREACH_ARRAY(d, displays, n_displays)
+                draw_cell(d, x, y, cell);
+}
+
+/* Shifts the text area up a row using the GOP's own video-to-video copy, which is one call per
+ * display rather than one per character cell. */
+static void scroll_up(void) {
+        uint8_t attr = textfb_mode.Attribute;
+
+        for (size_t y = 0; y + 1 < n_rows; y++)
+                memcpy(grid + y * n_cols, grid + (y + 1) * n_cols, n_cols * sizeof(Cell));
+        for (size_t x = 0; x < n_cols; x++) {
+                Cell blank = { .c = ' ', .attr = attr };
+                grid[(n_rows - 1) * n_cols + x] = blank;
+        }
+
+        FOREACH_ARRAY(d, displays, n_displays) {
+                uint32_t cw = FONT_WIDTH * d->font_scale, ch = FONT_HEIGHT * d->font_scale;
+                EFI_GRAPHICS_OUTPUT_BLT_PIXEL bg = palette[(attr >> 4) & 0x0f];
+
+                (void) d->gop->Blt(d->gop, NULL, EfiBltVideoToVideo,
+                                   d->x_off, d->y_off + ch,
+                                   d->x_off, d->y_off,
+                                   n_cols * cw, (n_rows - 1) * ch, 0);
+                (void) d->gop->Blt(d->gop, &bg, EfiBltVideoFill, 0, 0,
+                                   d->x_off, d->y_off + (n_rows - 1) * ch,
+                                   n_cols * cw, ch, 0);
+        }
+}
+
+static void cursor_newline(void) {
+        textfb_mode.CursorRow++;
+        if ((size_t) textfb_mode.CursorRow >= n_rows) {
+                scroll_up();
+                textfb_mode.CursorRow = n_rows - 1;
+        }
+}
+
+/* EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL implementation. */
+
+static EFI_STATUS EFIAPI textfb_reset(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, bool extended) {
+        return textfb_proto.ClearScreen(this);
+}
+
+static EFI_STATUS EFIAPI textfb_output_string(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, char16_t *s) {
+        if (!s)
+                return EFI_INVALID_PARAMETER;
+
+        for (; *s; s++)
+                switch (*s) {
+                case '\r':
+                        textfb_mode.CursorColumn = 0;
+                        break;
+
+                case '\n':
+                        cursor_newline();
+                        break;
+
+                case '\b':
+                        if (textfb_mode.CursorColumn > 0)
+                                textfb_mode.CursorColumn--;
+                        break;
+
+                case '\t':
+                        /* Next multiple of 8, as the spec's terminals do. */
+                        textfb_mode.CursorColumn = (textfb_mode.CursorColumn + 8) & ~7;
+                        if ((size_t) textfb_mode.CursorColumn >= n_cols) {
+                                textfb_mode.CursorColumn = 0;
+                                cursor_newline();
+                        }
+                        break;
+
+                default:
+                        if ((size_t) textfb_mode.CursorColumn >= n_cols) {
+                                textfb_mode.CursorColumn = 0;
+                                cursor_newline();
+                        }
+
+                        write_cell(textfb_mode.CursorColumn,
+                                   textfb_mode.CursorRow,
+                                   *s,
+                                   textfb_mode.Attribute);
+                        textfb_mode.CursorColumn++;
+                }
+
+        return EFI_SUCCESS;
+}
+
+/* Reporting the truth here is what makes boot.c's unicode_supported() fall back to ASCII box
+ * drawing instead of asking us for glyphs the font does not have. */
+static EFI_STATUS EFIAPI textfb_test_string(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, char16_t *s) {
+        if (!s)
+                return EFI_INVALID_PARAMETER;
+
+        for (; *s; s++)
+                if (!IN_SET(*s, '\r', '\n', '\b', '\t') &&
+                    (*s < FONT_FIRST_CHAR || *s > FONT_LAST_CHAR))
+                        return EFI_UNSUPPORTED;
+
+        return EFI_SUCCESS;
+}
+
+static EFI_STATUS EFIAPI textfb_query_mode(
+                EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, size_t mode, size_t *ret_cols, size_t *ret_rows) {
+        if (mode >= N_MODES)
+                return EFI_UNSUPPORTED;
+        if (!ret_cols || !ret_rows)
+                return EFI_INVALID_PARAMETER;
+
+        size_t cols, rows;
+        if (!layout((int32_t) mode, /* apply= */ false, &cols, &rows))
+                return EFI_UNSUPPORTED;
+
+        *ret_cols = cols;
+        *ret_rows = rows;
+        return EFI_SUCCESS;
+}
+
+static EFI_STATUS EFIAPI textfb_set_mode(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, size_t mode) {
+        if (mode >= N_MODES)
+                return EFI_UNSUPPORTED;
+
+        size_t cols, rows;
+        if (!layout((int32_t) mode, /* apply= */ true, &cols, &rows)) {
+                /* Put the layout we had before probing this mode back. */
+                (void) layout(textfb_mode.Mode, /* apply= */ true, &cols, &rows);
+                return EFI_UNSUPPORTED;
+        }
+
+        if (cols != n_cols || rows != n_rows) {
+                grid = xrealloc(grid, n_cols * n_rows * sizeof(Cell), cols * rows * sizeof(Cell));
+                n_cols = cols;
+                n_rows = rows;
+                generation++;
+        }
+
+        textfb_mode.Mode = mode;
+        ensure_cell_buf();
+
+        for (size_t i = 0; i < n_cols * n_rows; i++) {
+                Cell blank = { .c = ' ', .attr = textfb_mode.Attribute };
+                grid[i] = blank;
+        }
+
+        textfb_mode.CursorColumn = 0;
+        textfb_mode.CursorRow = 0;
+
+        FOREACH_ARRAY(d, displays, n_displays)
+                fill_display(d, textfb_mode.Attribute);
+
+        return EFI_SUCCESS;
+}
+
+static EFI_STATUS EFIAPI textfb_set_attribute(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, size_t attr) {
+        textfb_mode.Attribute = attr & 0xff;
+        return EFI_SUCCESS;
+}
+
+static EFI_STATUS EFIAPI textfb_clear_screen(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this) {
+        for (size_t i = 0; i < n_cols * n_rows; i++) {
+                Cell blank = { .c = ' ', .attr = textfb_mode.Attribute };
+                grid[i] = blank;
+        }
+
+        textfb_mode.CursorColumn = 0;
+        textfb_mode.CursorRow = 0;
+
+        FOREACH_ARRAY(d, displays, n_displays)
+                fill_display(d, textfb_mode.Attribute);
+
+        return EFI_SUCCESS;
+}
+
+static EFI_STATUS EFIAPI textfb_set_cursor_position(
+                EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, size_t col, size_t row) {
+        if (col >= n_cols || row >= n_rows)
+                return EFI_UNSUPPORTED;
+
+        textfb_mode.CursorColumn = col;
+        textfb_mode.CursorRow = row;
+        return EFI_SUCCESS;
+}
+
+/* The menu and line editor draw their own caret by swapping colours, so there is nothing to do. */
+static EFI_STATUS EFIAPI textfb_enable_cursor(EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *this, bool visible) {
+        textfb_mode.CursorVisible = visible;
+        return EFI_SUCCESS;
+}
+
+bool textfb_active(void) {
+        return saved_conout;
+}
+
+/* Bumped whenever the character grid changes size, so the menu knows to recompute its layout. */
+uint64_t textfb_generation(void) {
+        return generation;
+}
+
+bool textfb_init(void) {
+        if (textfb_active())
+                return true;
+
+        /* Coming back after a failed chainload: the renderer is still set up, just not installed. */
+        if (initialized) {
+                saved_conout = ST->ConOut;
+                ST->ConOut = &textfb_proto;
+                repaint_all();
+                return true;
+        }
+
+        n_displays = gop_enumerate(&displays);
+        if (n_displays == 0)
+                return false;
+
+        textfb_mode = (TextFbMode) {
+                .MaxMode = N_MODES,
+                .Mode = 0,
+                .Attribute = EFI_TEXT_ATTR(EFI_LIGHTGRAY, EFI_BLACK),
+        };
+
+        size_t cols, rows;
+        if (!layout(0, /* apply= */ true, &cols, &rows)) {
+                log_debug("No display can show a usable text grid, leaving the firmware console alone.");
+                displays = mfree(displays);
+                n_displays = 0;
+                return false;
+        }
+
+        n_cols = cols;
+        n_rows = rows;
+        grid = xnew(Cell, n_cols * n_rows);
+        for (size_t i = 0; i < n_cols * n_rows; i++) {
+                Cell blank = { .c = ' ', .attr = textfb_mode.Attribute };
+                grid[i] = blank;
+        }
+        ensure_cell_buf();
+
+        textfb_proto = (EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL) {
+                .Reset = textfb_reset,
+                .OutputString = textfb_output_string,
+                .TestString = textfb_test_string,
+                .QueryMode = textfb_query_mode,
+                .SetMode = textfb_set_mode,
+                .SetAttribute = textfb_set_attribute,
+                .ClearScreen = textfb_clear_screen,
+                .SetCursorPosition = textfb_set_cursor_position,
+                .EnableCursor = textfb_enable_cursor,
+                .Mode = (void *) &textfb_mode,
+        };
+
+        FOREACH_ARRAY(d, displays, n_displays)
+                fill_display(d, textfb_mode.Attribute);
+
+        /* Taking over ST->ConOut means util.c, efi-string.c and efi-log.c keep working untouched. */
+        saved_conout = ST->ConOut;
+        ST->ConOut = &textfb_proto;
+
+        initialized = true;
+        log_debug("Text console now spans %zu display(s) at %zux%zu characters.", n_displays, n_cols, n_rows);
+        return true;
+}
+
+void textfb_restore(void) {
+        if (!textfb_active())
+                return;
+
+        ST->ConOut = saved_conout;
+        saved_conout = NULL;
+}
+
+/* Rebuilds the shared grid after the display set changed. Bumps the generation so the menu knows to
+ * redo its own layout. */
+static void relayout(void) {
+        size_t cols, rows;
+
+        if (!layout(textfb_mode.Mode, /* apply= */ true, &cols, &rows))
+                return;
+
+        if (cols != n_cols || rows != n_rows) {
+                grid = xrealloc(grid, n_cols * n_rows * sizeof(Cell), cols * rows * sizeof(Cell));
+                n_cols = cols;
+                n_rows = rows;
+                generation++;
+
+                for (size_t i = 0; i < n_cols * n_rows; i++) {
+                        Cell blank = { .c = ' ', .attr = textfb_mode.Attribute };
+                        grid[i] = blank;
+                }
+                textfb_mode.CursorColumn = 0;
+                textfb_mode.CursorRow = 0;
+        }
+
+        ensure_cell_buf();
+}
+
+bool textfb_poll(bool allow_reconnect) {
+        if (!textfb_active())
+                return false;
+
+        /* Reconnecting replaces the firmware's GOP instances, which invalidates every pointer and
+         * handle we are holding, so the only safe move afterwards is to start over. */
+        if (allow_reconnect && gop_force_reconnect() == EFI_SUCCESS) {
+                displays = mfree(displays);
+                n_displays = gop_enumerate(&displays);
+
+                if (n_displays == 0) {
+                        /* We have nothing to draw on any more -- give the console back. */
+                        log_debug("No displays survived the reconnect, restoring the firmware console.");
+                        initialized = false;
+                        textfb_restore();
+                        return false;
+                }
+
+                relayout();
+                repaint_all();
+                return true;
+        }
+
+        bool changed = false;
+
+        FOREACH_ARRAY(d, displays, n_displays)
+                if (gop_reassert_mode(d))
+                        changed = true;
+
+        size_t added = gop_rescan(&displays, n_displays);
+        if (added > 0) {
+                n_displays += added;
+                log_debug("Picked up %zu new display(s), now %zu.", added, n_displays);
+
+                /* A new display can be smaller than the others, which shrinks the shared grid. */
+                relayout();
+                changed = true;
+        }
+
+        if (changed)
+                repaint_all();
+
+        return changed;
+}
+
+size_t textfb_n_displays(void) {
+        return n_displays;
+}
+
+bool textfb_describe(
+                size_t i,
+                uint32_t *ret_width,
+                uint32_t *ret_height,
+                uint32_t *ret_native_width,
+                uint32_t *ret_native_height,
+                uint32_t *ret_font_scale) {
+
+        if (i >= n_displays)
+                return false;
+
+        if (ret_width)
+                *ret_width = displays[i].width;
+        if (ret_height)
+                *ret_height = displays[i].height;
+        if (ret_native_width)
+                *ret_native_width = displays[i].native_width;
+        if (ret_native_height)
+                *ret_native_height = displays[i].native_height;
+        if (ret_font_scale)
+                *ret_font_scale = displays[i].font_scale;
+
+        return true;
+}
diff --git a/src/boot/textfb.h b/src/boot/textfb.h
new file mode 100644
index 0000000000..dccd5f0fb4
--- /dev/null
+++ b/src/boot/textfb.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "efi.h"
+
+/* A multi-display text console. Implements EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL over every GOP the
+ * firmware exposes and installs itself as ST->ConOut, so sd-boot's existing output goes to all
+ * displays at once -- each at its own native resolution, with the font scaled to suit. The logical
+ * character grid is shared (it is the smallest grid every display can show), so the displays mirror
+ * each other without being forced into a common pixel mode the way ConSplitter forces them. */
+
+bool textfb_init(void);
+
+bool textfb_active(void);
+
+/* Hands ST->ConOut back to the firmware. Must happen before chainloading, since our protocol lives
+ * in sd-boot's own memory. */
+void textfb_restore(void);
+
+/* Picks up displays that appeared since init and re-asserts modes on the ones we know, which is
+ * what can wake a monitor that was asleep when sd-boot started. True if anything changed. */
+bool textfb_poll(bool allow_reconnect);
+
+size_t textfb_n_displays(void);
+
+/* For the menu's status screen. */
+bool textfb_describe(
+                size_t i,
+                uint32_t *ret_width,
+                uint32_t *ret_height,
+                uint32_t *ret_native_width,
+                uint32_t *ret_native_height,
+                uint32_t *ret_font_scale);
+
+/* Changes whenever the character grid is resized. */
+uint64_t textfb_generation(void);
diff --git a/src/fundamental/edid.c b/src/fundamental/edid.c
index 980a3989b7..9283d033ea 100644
--- a/src/fundamental/edid.c
+++ b/src/fundamental/edid.c
@@ -51,3 +51,28 @@ int edid_get_panel_id(const EdidHeader *edid_header, char16_t ret_panel[static 8
         ret_panel[7] = L'\0';
         return 0;
 }
+
+/* Native resolution from the first detailed timing descriptor at offset 54. EDID lists the
+ * preferred timing there, which for a fixed-pixel panel is its native mode. */
+int edid_get_preferred_mode(const void *blob, size_t blob_size, uint32_t *ret_width, uint32_t *ret_height) {
+        assert(ret_width);
+        assert(ret_height);
+
+        if (blob_size < 128)
+                return -EINVAL;
+
+        const uint8_t *dtd = (const uint8_t *) ASSERT_PTR(blob) + 54;
+
+        /* A zero pixel clock means this slot holds a display descriptor, not a timing. */
+        if (dtd[0] == 0 && dtd[1] == 0)
+                return -EINVAL;
+
+        uint32_t w = (uint32_t) dtd[2] | (((uint32_t) dtd[4] & 0xF0) << 4);
+        uint32_t h = (uint32_t) dtd[5] | (((uint32_t) dtd[7] & 0xF0) << 4);
+        if (w == 0 || h == 0)
+                return -EINVAL;
+
+        *ret_width = w;
+        *ret_height = h;
+        return 0;
+}
