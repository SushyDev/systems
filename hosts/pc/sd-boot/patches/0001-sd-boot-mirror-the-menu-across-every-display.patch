diff --git a/src/boot/console.c b/src/boot/console.c
index 06070347e3..95a30d5fe4 100644
--- a/src/boot/console.c
+++ b/src/boot/console.c
@@ -7,6 +7,7 @@
 #include "proto/graphics-output.h"
 #include "proto/pci-io.h"
 #include "string-util.h"
+#include "textfb.h"
 #include "util.h"
 
 #define SYSTEM_FONT_WIDTH 8
@@ -15,6 +16,18 @@
 #define VERTICAL_MAX_OK 1080
 #define VIEWPORT_RATIO 10
 
+/* How often to look for displays that appeared after we started. */
+#define DISPLAY_POLL_USEC UINT64_C(1000000)
+/* Forcing a controller re-probe is disruptive, so do it on only every Nth poll. */
+#define DISPLAY_RECONNECT_EVERY 5
+
+static bool display_reconnect_enabled = false;
+static uint64_t poll_count = 0;
+
+void console_set_display_reconnect(bool enable) {
+        display_reconnect_enabled = enable;
+}
+
 static void event_closep(EFI_EVENT *event) {
         assert(event);
 
@@ -89,11 +102,16 @@ EFI_STATUS console_key_read(uint64_t *ret_key, uint64_t timeout_usec) {
                 uint64_t watchdog_timeout_sec = 5 * 60,
                        watchdog_ping_usec = watchdog_timeout_sec / 2 * 1000 * 1000;
 
+                /* While we own the console, wake up every second so a display that was asleep when
+                 * sd-boot started still gets picked up without the user having to press anything. */
+                uint64_t tick_usec = textfb_active() ?
+                                MIN(watchdog_ping_usec, DISPLAY_POLL_USEC) : watchdog_ping_usec;
+
                 /* SetTimer expects 100ns units for some reason. */
                 err = BS->SetTimer(
                                 timer,
                                 TimerRelative,
-                                MIN(timeout_usec, watchdog_ping_usec) * 10);
+                                MIN(timeout_usec, tick_usec) * 10);
                 if (err != EFI_SUCCESS)
                         return log_error_status(err, "Error arming timer event: %m");
 
@@ -108,11 +126,15 @@ EFI_STATUS console_key_read(uint64_t *ret_key, uint64_t timeout_usec) {
                 if (timer != events[index])
                         break;
 
-                /* The EFI timer fired instead. If this was a watchdog timeout, loop again. */
+                /* The EFI timer fired instead. */
+                if (textfb_active())
+                        (void) textfb_poll(display_reconnect_enabled && ++poll_count % DISPLAY_RECONNECT_EVERY == 0);
+
+                /* If this was just a watchdog or display-poll tick, loop again. */
                 if (timeout_usec == UINT64_MAX)
                         continue;
-                else if (timeout_usec > watchdog_ping_usec) {
-                        timeout_usec -= watchdog_ping_usec;
+                else if (timeout_usec > tick_usec) {
+                        timeout_usec -= tick_usec;
                         continue;
                 }
 
