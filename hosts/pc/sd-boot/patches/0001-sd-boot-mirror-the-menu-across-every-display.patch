index 0000000000..9c35b70814
--- /dev/null
+++ b/src/boot/gop.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "efi.h"
+#include "proto/graphics-output.h"
+
+/* One entry per display the firmware exposes a GOP for. The hardware half is owned by gop.c; the
+ * render half (font_scale and below) is written only by textfb.c. */
+typedef struct GopDisplay {
+        EFI_HANDLE handle;
+        EFI_GRAPHICS_OUTPUT_PROTOCOL *gop;
+
+        uint32_t width, height;      /* pixel size of the mode we selected */
+        uint32_t mode;               /* GOP mode number we selected */
+        uint32_t native_width;       /* EDID preferred timing, 0 if unknown */
+        uint32_t native_height;
+
+        uint32_t font_scale;         /* integer upscale factor for the 8x16 font */
+        uint32_t x_off, y_off;       /* top-left of the centred text area, in pixels */
+} GopDisplay;
+
+/* Discovers every usable GOP and puts each into its best mode. Returns the number found. */
+size_t gop_enumerate(GopDisplay **ret_displays);
+
+/* Re-scans for handles that appeared since gop_enumerate(). Appends any new ones (already
+ * mode-set) and returns how many were added. */
+size_t gop_rescan(GopDisplay **displays, size_t n_displays);
+
+/* Re-asserts the selected mode if the firmware reports the display fell out of it. True if a
+ * mode set actually happened, meaning the caller must repaint. */
+bool gop_reassert_mode(GopDisplay *d);
+
+EFI_STATUS gop_force_reconnect(void);
